# Copy to .env and fill in. Never commit .env.

# --- Safety rails ---
# DRY_RUN=true records the order locally and sends nothing to any venue.
DRY_RUN=true
# Hard cap on notional (price * size) per order, in USD.
MAX_ORDER_USD=25
HOST=127.0.0.1
PORT=8000
DB_PATH=builder_lab.db
POLL_SECONDS=30

# --- Polymarket (prediction markets + perps): TRADER wallet ---
# Private key of the trader's signer. Stays on this machine.
POLY_PRIVATE_KEY=
# Optional: Polymarket wallet to act for. Defaults to the signer's deposit wallet.
POLY_WALLET_ADDRESS=

# --- Polymarket prediction markets: BUILDER identity (public) ---
# bytes32 code from polymarket.com/settings?tab=builder
POLY_BUILDER_CODE=

# --- Polymarket Perps: BUILDER identity ---
# Perps account address of the builder. Must differ from the trader.
POLY_PERPS_BUILDER_ADDRESS=
# Max builder fee the trader approves, in basis points (venue cap: 10).
POLY_PERPS_BUILDER_FEE_BPS=0
# Optional: builder account key, only used to read builder earnings.
POLY_PERPS_BUILDER_PRIVATE_KEY=

# --- Hyperliquid ---
# testnet | mainnet
HL_NETWORK=testnet
# TRADER main wallet key (builder fee approval must be signed by the main wallet).
HL_PRIVATE_KEY=
# Optional: account address if HL_PRIVATE_KEY is an agent/API wallet.
HL_ACCOUNT_ADDRESS=
# BUILDER wallet address (needs >= 100 USDC perps account value). Public.
HL_BUILDER_ADDRESS=
# Builder fee per order in basis points (cap: 10 on perps).
HL_BUILDER_FEE_BPS=0
